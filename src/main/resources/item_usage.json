    "Schema:",
    "  verb     : action label shown to the LLM (Burn, Cook, Bury, Smelt, Tan)",
    "  skill    : ['SkillCode', level]",
    "  tool     : item that must also be in inventory to perform the action",
    "  facility : where the action is done (fire/campfire, range, altar, ...)",
    "  members  : true if members-only"
